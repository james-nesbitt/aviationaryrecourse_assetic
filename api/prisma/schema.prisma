// assetic POC Prisma schema — mirrors the raw SQL migrations in db/migrations/
// Uses raw SQL migrations (not Prisma migrate) for the hash-chained journal and grants.
// Prisma client is generated from this schema for typed DB access on state tables.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Airport {
  iata         String @id @db.Char(3)
  icao         String
  name         String
  city         String
  country      String
  countryCode  String @map("country_code") @db.Char(2)
  latitude     Float
  longitude    Float
  elevationFt  Int    @map("elevation_ft")
  timezone     String

  @@map("airport")
}

model AircraftModel {
  modelId            String @id @map("model_id")
  manufacturer       String
  family             String
  icaoType           String @map("icao_type")
  name               String
  paxCapacityTypical Int    @map("pax_capacity_typical")
  cargoCapacityKg    Int    @map("cargo_capacity_kg")
  rangeKm            Int    @map("range_km")
  engineCount        Int    @map("engine_count")
  category           String
  vehicles           Vehicle[]

  @@map("aircraft_model")
}

model Operator {
  operatorId     String         @id @map("operator_id")
  name           String         @unique
  type           String
  country        String
  hubIata        String         @map("hub_iata") @db.Char(3)
  foundedYear    Int            @map("founded_year")
  fleetSizeHint  Int            @map("fleet_size_hint")
  schemaVersion  Int            @default(1) @map("schema_version")
  generatedAt    DateTime       @map("generated_at") @db.Date
  vehicles       Vehicle[]
  staff          Staff[]
  facilities     Facility[]
  customers      CarrierCustomer[]
  cargo          Cargo[]
  routes         Route[]
  orders         AsseticOrder[]

  @@map("operator")
}

model Vehicle {
  vehicleId     String    @id @map("vehicle_id")
  kind          String
  operatorId    String    @map("operator_id")
  registration  String?
  modelId       String?   @map("model_id")
  status        String?
  seatConfig    Json?     @map("seat_config")
  gseType       String?   @map("gse_type")
  railType      String?   @map("rail_type")
  baseIata      String?   @map("base_iata") @db.Char(3)
  homeIata      String?   @map("home_iata") @db.Char(3)
  schemaVersion Int       @default(1) @map("schema_version")
  generatedAt   DateTime  @map("generated_at") @db.Date

  operator      Operator       @relation(fields: [operatorId], references: [operatorId])
  model         AircraftModel? @relation(fields: [modelId], references: [modelId])

  @@index([operatorId])
  @@index([kind])
  @@map("vehicle")
}


model OwnershipHistory {
  vehicleId       String @map("vehicle_id")
  sequence        Int
  fromOperatorId  String @map("from_operator_id")
  toOperatorId    String @map("to_operator_id")
  transferType    String @map("transfer_type")
  validTime       DateTime @map("valid_time") @db.Date

  @@id([vehicleId, sequence])
  @@map("ownership_history")
}

model Staff {
  staffId        String   @id @map("staff_id")
  givenName      String   @map("given_name")
  familyName     String   @map("family_name")
  roleClass      String   @map("role_class")
  role           String
  operatorId     String   @map("operator_id")
  baseIata       String   @map("base_iata") @db.Char(3)
  hireDate       DateTime @map("hire_date") @db.Date
  certifications Json     @default("[]")
  schemaVersion  Int      @default(1) @map("schema_version")
  generatedAt    DateTime @map("generated_at") @db.Date
  keycloakUsername String? @unique @map("keycloak_username")

  operator       Operator @relation(fields: [operatorId], references: [operatorId])

  @@index([operatorId])
  @@index([role])
  @@map("staff")
}

model Facility {
  facilityId     String   @id @map("facility_id")
  facilityType   String   @map("facility_type")
  operatorId     String   @map("operator_id")
  airportIata    String   @map("airport_iata") @db.Char(3)
  capacityUnits  Int      @map("capacity_units")
  schemaVersion  Int      @default(1) @map("schema_version")
  generatedAt    DateTime @map("generated_at") @db.Date

  operator       Operator @relation(fields: [operatorId], references: [operatorId])

  @@index([operatorId])
  @@map("facility")
}

model CarrierCustomer {
  customerId        String    @id @map("customer_id")
  customerType      String    @map("customer_type")
  companyName       String    @map("company_name")
  operatorId        String    @map("operator_id")
  accountManagerId  String?   @map("account_manager_id")
  contractStart     DateTime  @map("contract_start") @db.Date
  monthlyVolumeKg   Int?      @map("monthly_volume_kg")
  schemaVersion     Int       @default(1) @map("schema_version")
  generatedAt       DateTime  @map("generated_at") @db.Date

  operator          Operator @relation(fields: [operatorId], references: [operatorId])
  cargo             Cargo[]
  orders            AsseticOrder[]

  @@index([operatorId])
  @@map("carrier_customer")
}

model Cargo {
  cargoId           String   @id @map("cargo_id")
  customerId        String   @map("customer_id")
  operatorId        String   @map("operator_id")
  originIata        String   @map("origin_iata") @db.Char(3)
  destinationIata   String   @map("destination_iata") @db.Char(3)
  assignedVehicleId String?  @map("assigned_vehicle_id")
  tripId            String?  @map("trip_id")
  weightKg          Int      @map("weight_kg")
  cargoType         String   @map("cargo_type")
  validTime         DateTime @map("valid_time") @db.Date
  schemaVersion     Int      @default(1) @map("schema_version")
  generatedAt       DateTime @map("generated_at") @db.Date

  customer          CarrierCustomer @relation(fields: [customerId], references: [customerId])
  operator          Operator        @relation(fields: [operatorId], references: [operatorId])

  @@index([customerId])
  @@index([operatorId])
  @@map("cargo")
}

model Route {
  routeId       String   @id @map("route_id")
  operatorId    String   @map("operator_id")
  vehicleId     String   @map("vehicle_id")
  routeType     String   @map("route_type")
  baseIata      String   @map("base_iata") @db.Char(3)
  frequencyDays Int      @map("frequency_days")
  firstOperatingDate DateTime @map("first_operating_date") @db.Date
  legs          Json
  schemaVersion Int      @default(1) @map("schema_version")
  generatedAt   DateTime @map("generated_at") @db.Date

  operator      Operator @relation(fields: [operatorId], references: [operatorId])

  @@index([operatorId])
  @@index([vehicleId])
  @@map("route")
}

model AsseticOrder {
  orderId           String   @id @map("order_id")
  customerId        String   @map("customer_id")
  operatorId        String   @map("operator_id")
  orderType         String   @map("order_type")
  accountManagerId  String?  @map("account_manager_id")
  tripManagerId     String?  @map("trip_manager_id")
  originIata        String   @map("origin_iata") @db.Char(3)
  destinationIata   String   @map("destination_iata") @db.Char(3)
  plannedLegs       Json     @map("planned_legs")
  transitRouteIds   Json     @default("[]") @map("transit_route_ids")
  orderedOn         DateTime @map("ordered_on") @db.Date
  status            String
  passengerGroup    Json?    @map("passenger_group")
  freight           Json?
  schemaVersion     Int      @default(1) @map("schema_version")
  generatedAt       DateTime @map("generated_at") @db.Date

  customer          CarrierCustomer @relation(fields: [customerId], references: [customerId])
  operator          Operator        @relation(fields: [operatorId], references: [operatorId])

  @@index([customerId])
  @@index([operatorId])
  @@index([status])
  @@map("assetic_order")
}

// Journal is managed via raw SQL (see db/migrations/001_initial_schema.sql).
// Prisma does not manage this table's schema; we use $queryRaw for appends.
// model JournalEntry is intentionally omitted from Prisma to keep the

model Passenger {
  passengerId     String   @id @map("passenger_id")
  givenName       String   @map("given_name")
  familyName      String   @map("family_name")
  passengerType   String   @map("passenger_type")
  orderId         String?  @map("order_id")
  tripId          String?  @map("trip_id")
  operatorId      String   @map("operator_id")
  originIata      String   @map("origin_iata") @db.Char(3)
  destinationIata String   @map("destination_iata") @db.Char(3)
  validTime       DateTime @map("valid_time") @db.Date
  schemaVersion   Int      @default(1) @map("schema_version")
  generatedAt     DateTime @map("generated_at") @db.Date

  @@index([operatorId])
  @@index([orderId])
  @@map("passenger")
}

model VehicleMaintenance {
  maintenanceId   String   @id @map("maintenance_id")
  vehicleId       String   @map("vehicle_id")
  facilityId      String?  @map("facility_id")
  maintenanceType String   @map("maintenance_type")
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  status          String
  schemaVersion   Int      @default(1) @map("schema_version")
  generatedAt     DateTime @map("generated_at") @db.Date

  @@index([vehicleId, startDate])
  @@map("vehicle_maintenance")
}

model RouteAssignment {
  assignmentId       String    @id @map("assignment_id")
  routeId            String    @map("route_id")
  vehicleId          String    @map("vehicle_id")
  validFrom          DateTime  @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  reason             String
  replacesVehicleId  String?   @map("replaces_vehicle_id")
  schemaVersion      Int       @default(1) @map("schema_version")
  generatedAt        DateTime  @map("generated_at") @db.Date

  @@index([routeId, validFrom])
  @@index([vehicleId, validFrom])
  @@map("route_assignment")
}

model Trip {
  tripId         String   @id @map("trip_id")
  routeId        String   @map("route_id")
  vehicleId      String   @map("vehicle_id")
  operatorId     String   @map("operator_id")
  operatingDate  DateTime @map("operating_date") @db.Date
  status         String
  legs           Json
  schemaVersion  Int      @default(1) @map("schema_version")
  generatedAt    DateTime @map("generated_at") @db.Date

  @@unique([routeId, operatingDate])
  @@index([vehicleId, operatingDate])
  @@index([operatorId, operatingDate])
  @@map("trip")
}

model CrewAssignment {
  assignmentId  String   @id @map("assignment_id")
  tripId        String   @map("trip_id")
  staffId       String   @map("staff_id")
  crewRole      String   @map("crew_role")
  schemaVersion Int      @default(1) @map("schema_version")
  generatedAt   DateTime @map("generated_at") @db.Date

  @@unique([tripId, staffId])
  @@index([tripId])
  @@index([staffId])
  @@map("crew_assignment")
}

model TransitEvent {
  eventId       String   @id @map("event_id")
  subjectType   String   @map("subject_type")
  cargoId       String?  @map("cargo_id")
  passengerId   String?  @map("passenger_id")
  sequence      Int
  eventType     String   @map("event_type")
  fromState     String   @map("from_state")
  toState       String   @map("to_state")
  locationIata  String   @map("location_iata") @db.Char(3)
  vehicleId     String?  @map("vehicle_id")
  facilityId    String?  @map("facility_id")
  actorId       String?  @map("actor_id")
  validTime     DateTime @map("valid_time")
  schemaVersion Int      @default(1) @map("schema_version")
  generatedAt   DateTime @map("generated_at") @db.Date

  @@index([cargoId, sequence])
  @@index([passengerId, sequence])
  @@map("transit_event")
}